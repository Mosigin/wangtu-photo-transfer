{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "妄图照片直传": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wangtu Photo Transfer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "妄图照片直传"
          }
        }
      }
    },
    "已导入媒体：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media imported: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入媒体：%@"
          }
        }
      }
    },
    "可用空间：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available space: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间：%@"
          }
        }
      }
    },
    "等待电脑发送媒体": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for media from your computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待电脑发送媒体"
          }
        }
      }
    },
    "正在保存媒体…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving media…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存媒体…"
          }
        }
      }
    },
    "已达到预留空间，传输已停止": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved space reached. Transfer stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到预留空间，传输已停止"
          }
        }
      }
    },
    "请允许访问全部照片以核验导入结果": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full photo access to verify imported originals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许访问全部照片以核验导入结果"
          }
        }
      }
    },
    "导入遇到问题，已保留进度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import needs attention. Progress has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入遇到问题，已保留进度"
          }
        }
      }
    },
    "通过 USB 添加照片和视频，保留预留空间。已有媒体不会被删除。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds photos and videos over USB and keeps the reserved free space. Existing media is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 USB 添加照片和视频，保留预留空间。已有媒体不会被删除。"
          }
        }
      }
    },
    "暂停": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "开始写入": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始写入"
          }
        }
      }
